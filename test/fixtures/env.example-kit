# Copy to .env (gitignored). Never commit real values.

# Orchestrator: Codex. Leave CODEX_MODEL empty to use the model picked in Codex (/model).
# To pin one, copy its exact name from /model: names your account can't use are rejected.
CODEX_MODEL=
CODEX_ARGS=--sandbox workspace-write -c sandbox_workspace_write.network_access=true

# Workers: Antigravity CLI on your own plan. Empty AGY_MODEL = the model you picked in agy (/model).
# The permission flag is needed because headless agy otherwise stalls on approvals; the Doctor adds a
# deny-list (no push, no deletes, no ssh) to agy's settings to keep workers safe.
AGY_MODEL=
AGY_ARGS=--dangerously-skip-permissions --mode accept-edits --effort high

# Hub
NEXTLEVEL_WORKER_SLOTS=2
NEXTLEVEL_TASK_TIMEOUT_MIN=60
NEXTLEVEL_CHECK_TIMEOUT_MIN=30
# Local hour (0-23) for the daily report
NEXTLEVEL_REPORT_HOUR=20
# 1 = the hub wakes the orchestrator by itself (also toggled with START.cmd -> 6)
NEXTLEVEL_AUTOPILOT=0

# Phone notifications from the team and the daily report (https://ntfy.sh).
# The topic name works like a password: make it long and random. Needed for
# notifications.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
